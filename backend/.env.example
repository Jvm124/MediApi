# Credenciales locales del backend.
# Copia este archivo como .env en esta misma carpeta (backend/) y completa los valores.
# Git ignora .env, así que tus valores no se suben. Ver docs/adr/0003.
#
# Formato: NOMBRE=valor, una variable por línea.
# - Sin comillas ni espacios al final: se tomarían como parte del valor.
# - Sin tildes ni ñ en los valores: Spring Boot los leería mal.
# - Una barra invertida \ se escribe \\.
# - Si una variable también existe en Windows o en IntelliJ, gana esa y se ignora la de aquí.

# Obligatoria. Contraseña del usuario root de MySQL.
DB_PASSWORD=

# Obligatoria. Secreto para firmar los tokens JWT: una cadena larga y aleatoria.
# Puedes generar uno en Git Bash con: openssl rand -base64 48
JWT_SECRET=

# Administrador inicial. Solo se usa si todavía no existe ningún ADMINISTRADOR.
# La contraseña debe tener al menos 8 caracteres. Ver docs/adr/0002.
ADMIN_EMAIL=admin@voll.med
ADMIN_PASSWORD=
